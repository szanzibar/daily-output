# You only need the key for the provider + model picked in Settings (AI section):
#   Direct + GLM 5.2  → ZAI_API_KEY      Direct + Sonnet 4.6 → ANTHROPIC_API_KEY
#   OpenRouter (either model)            → OPENROUTER_API_KEY
# Default is Direct + GLM 5.2, so ZAI_API_KEY is enough out of the box.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# z.ai (GLM) API key. Get it from the z.ai console.
ZAI_API_KEY=your-zai-key-here
# OpenRouter key (sk-or-...) — only needed if you set the provider to OpenRouter in Settings.
OPENROUTER_API_KEY=
# Global default model (a "provider:model" spec) used only when Settings can't be read.
# Supported providers: anthropic, zai, openrouter. Examples: zai:glm-5.2 · anthropic:claude-sonnet-4-6.
# Leave blank to use the config.exs default (zai:glm-5.2).
AI_MODEL=
# Host-side published app port for docker-compose (for example 40005).
# The app still listens internally on :4000.
PORT=4000
# Public hostname used for URL generation and origin checks in production.
# Example: app.example.com
PHX_HOST=localhost
# (Web Push needs no config — the daily-reminder VAPID keys are generated and
# stored in the database on first boot.)
# Fallback timezone before the browser reports one (IANA name). Example: Europe/Berlin
DEFAULT_TIMEZONE=Etc/UTC
