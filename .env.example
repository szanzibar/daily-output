ANTHROPIC_API_KEY=sk-ant-your-key-here
# Host-side published app port for docker-compose (for example 40005).
# The app still listens internally on :4000.
PORT=4000
# Public hostname used for URL generation and origin checks in production.
# Example: app.example.com
PHX_HOST=localhost
# Web Push (daily reminder notifications). Optional — reminders stay off until set.
# Generate ready-to-paste lines with: mix daily_output.gen_vapid
# (Don't swap public/private — the public key is the longer one.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Fallback timezone before the browser reports one (IANA name). Example: Europe/Berlin
DEFAULT_TIMEZONE=Etc/UTC
