# You only need the key for the provider picked in Settings (AI section):
#   Direct (either model) → OPENAI_API_KEY   OpenRouter (either model) → OPENROUTER_API_KEY
# Default is Direct + GPT-6.1 Sol, so OPENAI_API_KEY is enough out of the box.
OPENAI_API_KEY=sk-your-key-here
# OpenRouter key (sk-or-...) — only needed if you set the provider to OpenRouter in Settings.
OPENROUTER_API_KEY=
# Anthropic key — optional, only used if you point a model at Anthropic (e.g. the bench).
ANTHROPIC_API_KEY=
# Host-side published app port for docker-compose (for example 40005).
# The app still listens internally on :4000.
PORT=4000
# Public hostname used for URL generation and origin checks in production.
# Example: app.example.com
PHX_HOST=localhost
# (Web Push needs no config — the daily-reminder VAPID keys are generated and
# stored in the database on first boot.)
# Fallback timezone before the browser reports one (IANA name). Example: Europe/Berlin
DEFAULT_TIMEZONE=Etc/UTC
